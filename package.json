{
  "name": "newpersonalsite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "resume": "node scripts/cv/launch.mjs sync",
    "cv:setup": "node scripts/cv/launch.mjs setup",
    "cv:sync": "node scripts/cv/launch.mjs sync",
    "cv:watch": "node scripts/cv/launch.mjs watch",
    "test:cv": "node --test tests/cv-*.test.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-scrollbar": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1"
  }
}
