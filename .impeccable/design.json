  "narrative": {
    "northStar": "Engineering Journal",
    "overview": "Engineering Journal treats engineering work as readable evidence. Warm paper, dark ink, editorial serif headings, and quiet sans-serif explanations give the portfolio the character of a considered technical publication. Broad colored system bands make relationships visible without competing with the supplied project facts.\n\nThe system is code-led: open layouts, fine rules, native disclosures, and inline SVG carry its identity. The existing portrait serves as a small personal signature; it does not establish an image-heavy visual language.",
    "keyCharacteristics": [
      "Oversized serif headings with precise sans-serif reading type.",
      "Flat paper surfaces, open rules, and broad project-colored system bands.",
      "Native disclosures, visible keyboard focus, and restrained motion."
    ],
    "rules": [
      {
        "name": "The Paper and Ink Rule",
        "body": "Keep reading surfaces on paper with ink or muted text; use vermilion for emphasis and interaction, and project colors for the corresponding system bands.",
        "section": "colors"
      },
      {
        "name": "The Open Journal Rule",
        "body": "Separate content with space and fine rules rather than raised card shells.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** pair Instrument Serif headings with Manrope reading and navigation text.",
      "**Do** use paper and ink as the default canvas, reserving colored bands for system explanations.",
      "**Do** preserve native disclosure semantics, keyboard focus, and reduced-motion support.",
      "**Do** keep diagrams as legible HTML and inline SVG that reflow vertically on mobile."
    ],
    "donts": [
      "**Don't** wrap open journal sections in rounded, elevated cards.",
      "**Don't** replace project-specific diagram symbols with unrelated decorative icons.",
      "**Don't** use project bands as a rainbow of arbitrary interface states.",
      "**Don't** add unsupported achievements or imagery that implies new factual evidence."
    ]
  }
